# Traceo — contoh env. Salin ke .env.local dan isi nilai sebenar.
# JANGAN commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (sandaran — dipakai hanya bila Gmail di bawah tidak dikonfigurasi)
RESEND_API_KEY=
EMAIL_FROM=

# Gmail SMTP via Nodemailer (diutamakan bila diisi — tiada servis tambahan perlu).
# GMAIL_APP_PASSWORD ialah App Password 16 aksara dari Google Account, BUKAN
# kata laluan login biasa. Cipta di: Google Account → Security → 2-Step
# Verification → App passwords.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# GMAIL_TLS_INSECURE=1 hanya bila antivirus laptop buat imbasan TLS sehingga
# sambungan ke Gmail gagal ("self-signed certificate"). Biarkan kosong jika tidak perlu.
# GMAIL_TLS_INSECURE=

# NOTIFY_EMAIL_OVERRIDE: hala SEMUA notifikasi ke satu alamat (pengujian).
# Wajib diisi selagi emel akaun pengguna (admin@traceo.dev dsb.) bukan peti
# sebenar. Kosongkan bila setiap akaun sudah guna emel sebenar (pengeluaran).
# NOTIFY_EMAIL_OVERRIDE=

# Sentry (gunakan DSN yang sama untuk kedua-dua)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI Assistant
GEMINI_API_KEY=
